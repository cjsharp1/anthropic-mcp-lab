{
  "name": "anthropic-mcp-lab",
  "version": "1.0.0",
  "description": "A teaching MCP server with a live inspector: watch every Model Context Protocol request and response, over stdio or Streamable HTTP, with tools, resources and prompts.",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "stdio": "tsx server/stdio.ts",
    "build": "tsc && tsc -p tsconfig.client.json && tsx scripts/copy-data.ts",
    "build:client": "tsc -p tsconfig.client.json",
    "watch:client": "tsc -p tsconfig.client.json --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check-env": "tsx scripts/check-env.ts",
    "try-stdio": "tsx scripts/try-stdio.ts",
    "try-http": "tsx scripts/try-http.ts",
    "audit-comments": "tsx scripts/audit-comments.ts"
  },
  "keywords": [
    "anthropic",
    "claude",
    "mcp",
    "model-context-protocol",
    "training"
  ],
  "author": "Chris Sharp",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
